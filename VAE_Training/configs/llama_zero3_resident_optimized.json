{
  "train_micro_batch_size_per_gpu": 32,
  "gradient_accumulation_steps": 4,
  "train_batch_size": 128,
  "bf16": {
    "enabled": true
  },
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 2e-05,
      "betas": [
        0.9,
        0.95
      ],
      "eps": 1e-08,
      "weight_decay": 0.01,
      "adam_w_mode": true
    }
  },
  "zero_optimization": {
    "stage": 3,
    "offload_param": {
      "device": "cpu",
      "pin_memory": false
    },
    "offload_optimizer": {
      "device": "nvme",
      "nvme_path": "__RUN_SWAP_DIRECTORY__",
      "buffer_count": 4,
      "pin_memory": false,
      "pipeline_read": false,
      "pipeline_write": false
    },
    "sub_group_size": 100000000,
    "reduce_bucket_size": 1000000,
    "stage3_prefetch_bucket_size": 0,
    "stage3_param_persistence_threshold": 1000000000,
    "stage3_max_live_parameters": 8000000000,
    "overlap_comm": false,
    "stage3_gather_16bit_weights_on_model_save": false,
    "stage3_max_reuse_distance": 1000000000,
    "stage3_model_persistence_threshold": 8000000000
  },
  "aio": {
    "block_size": 1048576,
    "queue_depth": 32,
    "thread_count": 4,
    "single_submit": false,
    "overlap_events": true
  },
  "gradient_clipping": 1.0,
  "steps_per_print": 100,
  "wall_clock_breakdown": false
}
